# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# Database (MySQL — matches team's chosen stack: MySQL/Firebase)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=pothole_ai

# Alternative: use SQLite for local dev with zero setup
# Uncomment to use instead of MySQL:
# USE_SQLITE=True

# Upload limits
MAX_CONTENT_LENGTH_MB=50

# Deployment (Render / Railway)
PORT=5000
